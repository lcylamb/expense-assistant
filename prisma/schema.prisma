// 报销单演示库的 schema。
//
// 设计原则（数据建模为什么这么选）：
//   1. 主表 + 明细表 —— 总额不单独存成「事实」，而是明细之和的投影（amount 由 seed 保证一致）。
//      真实系统里这里通常会加一条「对账」约束或触发器，练习项目保持在应用层校验。
//   2. 状态和分类用 enum 而不是自由字符串 —— 图形上它把模型的回答空间收窄了：
//      prompt 里可以把枚举值全部列出来，模型只能在合法值里选，结构化输出的校验才立得住。
//   3. 可空字段是「有信息量」的那种空，不是随手标的 —— rejectReason 只在 REJECTED 时有值，
//      decidedAt / approverName / approvalNote 只在已决策时有值。这给了「信息不足」一个自然的来源：
//      问一张还没决策的单子「审批意见是什么」，正确答案就是「数据里没有」，而不是编一个。
//   4. 审批意见和驳回原因分开存 —— 它们不是同一句话的两种叫法：驳回原因写给申请人看，
//      是「改完重提」的要求；审批意见是流程留痕，通过和打款也要有。合成一个字段，
//      通过的单就只能留空，前端那个「问审批意见」的入口就答不出来。
//   5. **不做审批流。** 单据上只记「这次决策的结果」：谁批的、什么时候、意见是什么。
//      没有审批节点、没有流转、没有加签、没有催办 —— 那些是审批流该做的事，不在本项目范围。
//      制度手册里写了三级审批，那是公司制度条款（见 policy-docs.ts），不是本系统实现的能力。

generator client {
  // ⚠️ Prisma 7 把 generator 从 `prisma-client-js` 改名为 `prisma-client`，
  // 而且 `output` 变成**必填**：生成的 client 不再塞进 node_modules/@prisma/client，
  // 而是落到项目里的下面这个路径，import 也改成相对路径。
  //
  // 好处是产物可见、类型跳转直接进源码；代价是每次 clone 后要跑一次 `prisma generate`
  // （已挂到 package.json 的 postinstall）。src/generated/ 在 .gitignore 里。
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // ⚠️ Prisma 7 起，schema 里**不能再写** `url = env("DATABASE_URL")`，
  // 写了会直接报 P1012。连接串移到 prisma.config.ts。
  // 原因：PrismaClient 不再自己管连接，改为接收一个 driver adapter（见 prisma.config.ts）。
  provider = "postgresql"
}

/// 报销单状态。取值刻意保持少而互斥。
enum ExpenseStatus {
  DRAFT // 草稿：还没提交，审批人看不到
  SUBMITTED // 待审批
  APPROVED // 已通过，等待打款
  REJECTED // 已驳回，此时 rejectReason 必有值
  PAID // 已打款
}

/// 费用分类。主表和明细共用一套取值，方便按分类做聚合。
enum ExpenseCategory {
  TRAVEL // 差旅
  OFFICE // 办公用品
  ENTERTAIN // 业务招待
  TRANSPORT // 市内交通
  OTHER // 其他
}

/// 账号角色。取值和 viewer.ts 的 ViewerRole 一一对应（那边是小写）。
enum UserRole {
  APPLICANT // 申请人：只能看自己的单
  APPROVER // 审批人：看全部已提交的单，草稿不可见
  AUDITOR // 审计：只读全部（含草稿），用来复核和对账
}

/// 一个能登录的账号。
///
/// ── 为什么要有这张表 ──
///
/// 权限的第一块砖不是「可见性规则」，是「你是谁」。之前身份由请求方自己声明
/// （body 里写 `viewer.name`），可见性规则再严密也只是在验证一句自称。
/// 有了账号表，身份才有唯一的出处：登录换来会话，会话里带 user id，
/// 服务端按 id 去查这个人是谁、能看什么。
///
/// passwordHash 只存 scrypt 派生值（格式见 src/modules/auth/password.ts），
/// 明文密码不进库、不进日志、不进 seed 的注释。
model User {
  id String @id @default(cuid())

  /// 登录名。用拼音而不是姓名：姓名会重、会改，登录名不会。
  username String @unique

  /// 显示名。与 Expense.applicant 快照对齐，页面上直接用。
  name       String
  role       UserRole
  department String

  passwordHash String

  createdAt DateTime @default(now())

  expenses Expense[]

  @@map("users")
}

/// 一张报销单。
model Expense {
  id String @id @default(cuid())

  /// 人可读的单号，如 BX-2026-0007。对外展示和提问都用它。
  code String @unique

  title String

  /// 提交人**姓名快照**，只用于展示和 prompt（改名不影响历史单据的写法）。
  /// 权限判定不认它 —— 认下面的 applicantId。同名同姓在真实公司里一定会发生，
  /// 用姓名当归属键，等于让重名的人互相看得见对方的单。
  applicant  String
  department String

  /// 归属人。可见性规则唯一认可的键（见 viewer.ts）。
  applicantId String
  applicantUser User @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  category ExpenseCategory

  /// 报销总额。等于所有 items.amount 之和 —— 由 seed 脚本计算写入，不手填。
  amount Decimal @db.Decimal(12, 2)

  status ExpenseStatus @default(DRAFT)

  /// 仅 REJECTED 时有值。见文件头第 3 条。
  rejectReason String?

  /// 决策人姓名快照。已决策（通过 / 驳回 / 打款）的单才有值，草稿和待审批为 null。
  /// 存快照而不是外键：真实审批人可能离职、换岗，历史单据上的签字不能跟着变。
  approverName String?

  /// 审批意见。通过和打款写这里；驳回的整改要求在 rejectReason 里。见文件头第 4 条。
  approvalNote String?

  submittedAt DateTime
  /// 决策时间（通过 / 驳回 / 打款）。草稿和待审批时为 null。
  decidedAt   DateTime?

  items ExpenseItem[]

  /// 按「最近提交的排前面」查列表是最常见的入口，索引直接建在它上面。
  @@index([submittedAt(sort: Desc)])
  @@index([status])
  /// 申请人视角的列表查询每次都带 `applicantId`，索引跟着这条路径建。
  @@index([applicantId])
  @@map("expenses")
}

/// 报销单下的一条费用明细。
model ExpenseItem {
  id String @id @default(cuid())

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  /// 费用事由，如「深圳→北京 高铁二等座」。
  name     String
  category ExpenseCategory
  amount   Decimal            @db.Decimal(12, 2)

  /// 补充说明。可空 —— 大多数明细没有备注。
  note String?

  /// 费用实际发生的日期。注意它和 Expense.submittedAt 不是一回事：
  /// 可以先发生、后报销，所以两者会相差几天甚至跨月。
  /// 提问「3 月发生了什么费用」时，正确答案按这个字段算，不按提交时间 —— 这是个好陷阱用例。
  spentOn DateTime

  @@index([expenseId])
  @@map("expense_items")
}
